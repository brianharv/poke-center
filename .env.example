# Local development only. The database is reached by service name inside Compose.
POSTGRES_USER=poke_center
POSTGRES_PASSWORD=poke_center_local
POSTGRES_DB=poke_center
DATABASE_URL=postgresql://poke_center:poke_center_local@localhost:5432/poke_center
APP_PORT=3000
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Poké Center <noreply@poke-center.test>"
BETTER_AUTH_URL=http://localhost:3000
# Generated locally by scripts/setup-env.mjs; never commit the real value.
BETTER_AUTH_SECRET=
